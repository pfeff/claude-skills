# Local L{N}-review verdict artifacts — never committed to git.
.claude/reviews/

# Per-job dispatch manifest (dispatch-gate) — ephemeral, never committed.
# Has leaked into main twice already (PR #136, and the stray copy this repo
# carried before it was git-rm'd from PR #143); ignore at the root cause.
.claude/task-context.md

# Host-local private-hostname blocklist for scripts/check-host-agnostic.sh.
# Contains private machine hostnames; must never be committed. Template:
# scripts/.private-tokens.example
scripts/.private-tokens

# Personal per-user Claude Code settings overrides — never committed.
.claude/settings.local.json

# Python test/byte-compile artifacts (skills/*/scripts test harnesses).
__pycache__/
*.pyc

# Workspace-rooted MCP config scaffolded by task-workflow's create-workspace.sh —
# carries a tenant-scoped MCP Bearer token (COORDINATOR_TOKEN). Never committed.
.mcp.json
